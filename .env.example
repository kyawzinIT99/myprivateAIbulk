# Antigravity Multi-Model AI — API Keys
# Copy this file to .env and fill in your keys
# Get keys from the links below — all FREE tier

# ── Ultra-Fast (FREE) ─────────────────────────────────────────────────────
# https://console.groq.com
GROQ_API_KEY=

# ── Long Context (FREE) ───────────────────────────────────────────────────
# https://aistudio.google.com → Get API Key
GEMINI_API_KEY=

# ── Multi-Model Gateway (FREE 50 req/day) ─────────────────────────────────
# https://openrouter.ai
OPENROUTER_API_KEY=

# ── GPT-4o / GPT-5 / o3 / DeepSeek (FREE via GitHub) ────────────────────
# https://github.com/settings/tokens → Generate token with no extra scopes
GITHUB_TOKEN=

# ── Edge AI (FREE 10,000 neurons/day) ────────────────────────────────────
# https://dash.cloudflare.com → Workers & Pages → AI
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# ── Fast Large Model (FREE) ───────────────────────────────────────────────
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# ── RAG / Retrieval (FREE 1000 req/month) ────────────────────────────────
# https://dashboard.cohere.ai
COHERE_API_KEY=

# ── Coding + Multilingual (FREE experiment tier) ──────────────────────────
# https://console.mistral.ai
MISTRAL_API_KEY=

# ── DeepSeek + Llama 4 ($5 trial credits) ────────────────────────────────
# https://cloud.sambanova.ai
SAMBANOVA_API_KEY=

# ── Open Models 40 req/min (FREE) ────────────────────────────────────────
# https://build.nvidia.com → API Key
NVIDIA_API_KEY=
